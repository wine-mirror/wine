SOURCES = \
	main.c \
	preloader.c \
	preloader_mac.c \
	wine.desktop \
	wine.inf.in \
	wine_info.plist.in

PROGRAMS = $(WINELOADER_PROGRAMS)
INSTALL_LIB = $(WINELOADER_PROGRAMS)
UNIX_CFLAGS = -fPIE

preloader_EXTRADEFS = -fno-builtin

wine_OBJS = main.o
wine_DEPS = $(WINELOADER_DEPENDS)
wine_LDFLAGS = $(WINELOADER_LDFLAGS) $(LDEXECFLAGS) $(PTHREAD_LIBS)

wine_app_OBJS = main.o
wine_app_DEPS = wine_arm64_entitlements.plist
wine_app_LDFLAGS = $(WINELOADER_LDFLAGS) $(LDEXECFLAGS) $(PTHREAD_LIBS)
wine_app_INFO_PLIST = wine_info.plist
wine_app_CODESIGN_FLAGS = -s "$(CODESIGN_IDENTITY)" -f --entitlements $(srcdir)/wine_arm64_entitlements.plist

wine_preloader_OBJS = preloader.o preloader_mac.o
wine_preloader_DEPS = $(WINELOADER_DEPENDS)
wine_preloader_LDFLAGS = $(WINEPRELOADER_LDFLAGS)
