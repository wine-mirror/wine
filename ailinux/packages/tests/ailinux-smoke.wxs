  <Product Id="{A113B749-7D27-4516-987B-9D015ACB69D0}" Name="AILinux Wine MSI Smoke" Language="1033" Version="1.0.0" Manufacturer="AILinux" UpgradeCode="{27D6EB58-EB72-4A17-9175-DA4F11E64560}">
