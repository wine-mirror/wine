import "oaidl.idl";

typedef struct NOTIFICATION_USER_INPUT_DATA
{
    const WCHAR *Key;
    const WCHAR *Value;
} NOTIFICATION_USER_INPUT_DATA;

[
    uuid("53E31837-6600-4A81-9395-75CFFE746F94"),
    object,
    pointer_default(ref)
]
interface INotificationActivationCallback : IUnknown
{
    HRESULT Activate( [in, string] const WCHAR *aumid, [in, string, unique] const WCHAR *args,
                      [in, size_is(count), unique] const NOTIFICATION_USER_INPUT_DATA *data, [in] ULONG count );
}
