EXTRADEFS = -DD3DX10_SDK_VERSION=43
MODULE    = d3dx10_43.dll
IMPORTLIB = d3dx10
IMPORTS   = d3d10_1 d3dcompiler_43 dxguid uuid gdi32 ole32 user32 wined3d
PARENTSRC = ../d3dx9_36
DELAYIMPORTS = windowscodecs

VER_FILEDESCRIPTION_STR = "Wine D3DX10"
VER_PRODUCTVERSION      = 9,29,952,3111

SOURCES = \
	async.c \
	d3dx10_43_main.c \
	d3dx10_compiler.c \
	d3dx_helpers.c \
	font.c \
	math.c \
	mesh.c \
	sprite.c \
	texture.c
