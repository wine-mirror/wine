#!/usr/bin/env python3
# Audit the native ELF program coverage of a configured RISC-V64 Wine build.
# SPDX-License-Identifier: LGPL-2.1-or-later

import argparse
import json
import re
import struct
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description="Audit ELF program coverage in a RISC-V64 Wine build.")
    parser.add_argument("build_dir", type=Path, help="configured RISC-V64 build directory")
    args = parser.parse_args()
    source_dir = Path(__file__).resolve().parent.parent
    makefile = args.build_dir / "Makefile"
    try:
        text = makefile.read_text()
    except OSError as error:
        parser.error(str(error))
    if not re.search(r"^HOST_ARCH\s*=\s*riscv64\s*$", text, re.MULTILINE):
        parser.error("build directory is not configured for native RISC-V64")
    disabled = re.search(r"^DISABLED_SUBDIRS\s*=([^\n]*)", text, re.MULTILINE)
    disabled = set(disabled[1].split()) if disabled else set()
    targets = set()
    for line in text.splitlines():
        if line.startswith("programs/") and ":" in line:
            targets.update(line.split(":", 1)[0].split())

    programs = []
    failures = 0
    for path in sorted((source_dir / "programs").glob("*/Makefile.in")):
        contents = path.read_text()
        module = re.search(r"^MODULE\s*=\s*(\S+)", contents, re.MULTILINE)
        if not module:
            continue
        name = path.parent.name
        target = "programs/{}/{}.so".format(name, module[1])
        entry = {"program": name, "module": module[1], "target": target}
        if "ENABLE_ARCHS = $(WIN16_ARCH)" in contents:
            entry.update(status="excluded", reason="Win16 execution is outside native 64-bit scope")
        elif name == "dpnsvr":
            entry.update(status="excluded", reason="also excluded by upstream native ARM64 architecture selection")
        elif "programs/" + name in disabled:
            entry.update(status="disabled-by-config")
        elif target not in targets:
            entry.update(status="missing-rule")
        else:
            try:
                with (args.build_dir / target).open("rb") as binary:
                    header = binary.read(64)
                if (len(header) == 64 and header[:6] == b"\x7fELF\x02\x01" and
                        struct.unpack_from("<HH", header, 16) == (3, 243)):
                    entry.update(status="built-elf")
                else:
                    entry.update(status="invalid-elf")
            except FileNotFoundError:
                entry.update(status="not-built")
            except OSError as error:
                entry.update(status="unreadable", reason=str(error))
        if entry["status"] not in ("built-elf", "excluded"):
            failures += 1
        programs.append(entry)
    counts = {}
    for entry in programs:
        counts[entry["status"]] = counts.get(entry["status"], 0) + 1
    print(json.dumps({"build_dir": str(args.build_dir.resolve()), "counts": counts,
                      "runtime_validation": "not assessed by this build audit",
                      "programs": programs}, indent=2))
    return bool(failures)


if __name__ == "__main__":
    raise SystemExit(main())
