MODULE       = quartz.dll
IMPORTLIB    = quartz
IMPORTS      = $(FFMPEG_PE_LIBS) strmiids dxguid strmbase uuid dsound msacm32 msvfw32 ole32 oleaut32 rpcrt4 user32 gdi32 advapi32 winmm
EXTRAINCL    = $(FFMPEG_PE_CFLAGS)
DELAYIMPORTS = ddraw

VER_PRODUCTVERSION  = 6,5,1,902
VER_OLESELFREGISTER = 1

SOURCES = \
	acmwrapper.c \
	avidec.c \
	colorconv.c \
	control_tlb.idl \
	decoder.c \
	dsoundrender.c \
	filesource.c \
	filtergraph.c \
	filtermapper.c \
	main.c \
	memallocator.c \
	parser.c \
	passthrough.c \
	quartz.rc \
	quartz_strmif.idl \
	systemclock.c \
	videorenderer.c \
	vmr7.c \
	vmr7_presenter.c \
	vmr9.c \
	window.c

dlldata_EXTRADEFS = -DENTRY_PREFIX=QUARTZ_ -DPROXY_DELEGATION -DWINE_REGISTER_DLL
